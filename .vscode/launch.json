{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pipeline (sample photos, debug)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pipeline.py",
      "args": [
        "--front", "sample/front.jpeg",
        "--side", "sample/side.jpeg",
        "--height", "170",
        "--debug"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Web interface (app.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
